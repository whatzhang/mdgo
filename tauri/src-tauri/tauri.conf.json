{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "mdgo",
  "version": "1.0.0",
  "identifier": "com.mdgo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node -e \"require('fs').rmSync('../dist',{recursive:true,force:true});require('fs').rmSync('../.vite',{recursive:true,force:true})\" && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1300,
        "height": 800,
        "minWidth": 1235,
        "minHeight": 750
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}